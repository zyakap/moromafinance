# Moroma Finance (LoanMasta tenant) — environment configuration template.
# Copy to .env, fill in real values, then: chmod 600 .env
# The .env file is git-ignored and loaded automatically by moromafinance/settings.py.

# --- Core ---
# Keep DEBUG=False in production. Only set True for local development.
DJANGO_DEBUG=False
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=moromafinance.com.pg,www.moromafinance.com.pg

# Public identity of this deployment (used for links, emails and PDF assets).
DJANGO_DOMAIN=https://www.moromafinance.com.pg
DJANGO_DOMAIN_DNS=moromafinance.com.pg
# Prefix for all Moroma-generated codes (loan references etc.).
MOROMA_CODE_PREFIX=MFX

# Secure cookies are sent by the browser over HTTPS only. Leave these unset
# (they default to True with DEBUG=False) for any real deployment. Set BOTH to
# False *only* for a temporary HTTP-only preview on a bare IP before TLS is
# issued — otherwise login silently fails with no useful error, because the
# browser refuses to send the session/CSRF cookies back. Remove these overrides
# the moment TLS is in place.
#DJANGO_SESSION_COOKIE_SECURE=False
#DJANGO_CSRF_COOKIE_SECURE=False

# --- Database ---
DB_ENGINE=django.db.backends.mysql
DB_NAME=moromafinance
DB_USER=moromafinance_app          # use a scoped, non-root DB user in production
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# --- Email (SMTP) ---
# Moroma mailboxes seen on client documents: sales@moromafinance.com.pg,
# mktosa@moromafinance.com.pg. Use the mailbox that should SEND system mail.
EMAIL_HOST=mail.moromafinance.com.pg
EMAIL_HOST_USER=sales@moromafinance.com.pg
EMAIL_HOST_PASSWORD=change-me
EMAIL_PORT=465
# Development/test notification receiver (defaults to mktosa@moromafinance.com.pg).
#TEST_RECEIVER=you@example.com

# --- reCAPTCHA ---
RECAPTCHA_PUBLIC_KEY=change-me
RECAPTCHA_PRIVATE_KEY=change-me

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Public Service Deduction Code ---
# Assigned to Moroma Finance by the payroll authority. Blank = not yet issued.
ALESCO_DC=

# --- DCC API (machine-to-machine) ---
# The three-value handshake connecting this tenant to the DCC credit bureau.
# All three are issued/confirmed in the DCC control panel (SaaS Admin ->
# Tenants): the tenant's LUID, its shared API key, and the bureau host.
# Blank values keep DCC dormant until Moroma is onboarded.
#
# This tenant's LUID — must match the LUID on the tenant's profile in DCC.
DCC_TENANT_LUID=
# Shared secret for this tenant. DCC sends it as X-API-KEY when pulling our
# feed, and we send the same key (plus X-TENANT-LUID) when running credit
# checks against DCC.
DCC_API_KEY=
# DCC bureau host, no scheme.
DCC_ENDPOINT=www.dinaucontrolcentre.com
# DCC_PROFILE_ID is numeric once issued; blank is tolerated while dormant.
DCC_PROFILE_ID=
# Set False only if the DCC bureau runs on a self-signed certificate.
DCC_VERIFY_SSL=True
# Scheme for outbound bureau calls. Use http ONLY if the bureau has no TLS
# listener — http sends the X-API-KEY in cleartext.
DCC_SCHEME=https
DCC_ALLOW_HTTP_FALLBACK=False
